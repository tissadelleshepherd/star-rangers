---
pagination:
  data: scenePovPages
  size: 1
  alias: item
  # Without this Eleventy adds only the FIRST paginated page to collections.all,
  # so src/sitemap.njk (which walks collections.all) listed exactly one scene-POV
  # page - the pitch POV of S00E01C01 - out of 312 built; found 2026-10-09 by
  # counting the live sitemap against the build. Every other collection in
  # .eleventy.js filters by layout or inputPath, so these pages reach nothing
  # else; the sitemap's own `item.included` guard still keeps hidden POVs out.
  addAllPagesToCollections: true
permalink: "{{ item.url }}"
layout: scene-pov.njk
eleventyComputed:
  # Gated like the body and `robots` below: a hidden POV page must not carry
  # the real chapter title or character label in its <title>, meta description
  # or Open Graph tags. Mirrors the excluded-page metadata .eleventy.js's
  # layout-swap override gives every other excluded page.
  title: "{% if item.included %}{{ item.character.label }} — Scene {{ item.sceneNumber }} — {{ item.chapterTitle }}{% else %}{% if edition.excludedNotice %}{{ edition.excludedNotice.title }}{% else %}Not included in this edition{% endif %}{% endif %}"
  description: "{% if item.included %}{{ item.character.label }}'s point of view of Scene {{ item.sceneNumber }} in \"{{ item.chapterTitle }}\".{% endif %}"
  # Ties this page's giscus discussion to its parent chapter's permanent
  # comment_id (see lib/content-schema.js) plus scene/character, rather than
  # this page's own pathname - so a discussion started here stays attached
  # to this exact scene/POV even if the parent chapter is later renumbered.
  comment_id: "{{ item.chapterCommentId }}-scene-{{ item.sceneNumber }}-{{ item.character.id }}"
  # A hidden POV page still returns HTTP 200 with a placeholder body - see the
  # `{% raw %}{% if item.included %}{% endraw %}` branch in _includes/scene-pov.njk - so it needs the
  # same `noindex, follow` the global override in .eleventy.js gives every
  # excluded.njk page. It cannot get it from there, and the reason is worth
  # stating because it is the same blind spot twice: these pages are generated
  # from THIS template, so classifyContentPath() sees inputPath
  # "src/scene-pov.njk", matches none of its content dirs, returns null, and
  # isContentIncluded() passes them straight through as included. Scene-POV
  # pages opt out of the layout-swap convention entirely and gate on
  # `item.included` instead (set per character in _data/scenePovPages.js), so
  # anything keyed to the swapped layout misses them. Empty string rather than
  # a value when included, because base.njk only emits the tag when truthy.
  robots: "{% if not item.included %}noindex, follow{% endif %}"
---
