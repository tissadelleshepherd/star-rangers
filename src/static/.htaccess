# Deny directory browsing
Options -Indexes

# Force HTTPS with a real 301.
#
# Search Console's 2026-08-08 coverage report showed Google crawling http://
# page URLs and filing them as "Alternative page with proper canonical tag" -
# not an error (the self-canonical in base.njk already points every http
# duplicate at its https URL, and Google indexes the https version), but it
# means the server was answering plain-http requests with a 200 and a full
# page, leaving a duplicate of the whole site one scheme away. A 301 is the
# stronger, cheaper signal: crawlers stop fetching the http copies at all,
# and every link or bookmark that still says http:// lands on the URL the
# canonicals, sitemap and feed already claim.
#
# /.well-known/ is exempt because cPanel AutoSSL's domain-control validation
# fetches its check file over plain http; redirecting that path can fail the
# renewal of the very certificate the redirect depends on.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Moved pages. mod_alias Redirect is resolved before the filesystem lookup, so
# these win over the equivalent meta-refresh stubs built into _site/ - the stubs
# exist for hosts without .htaccess (GitHub Pages), and a real 301 is better
# wherever it is available. Paths are root-relative because cpanel-deploy.sh
# strips the /star-rangers/ prefix from the built output before rsync.
Redirect 301 /lore/solar-system-concordant/ /lore/solar-system-concord/
Redirect 301 /codex/the-false-dragon/ /codex/the-borrowed-silhouette/
Redirect 301 /glossary/court-fae/ /glossary/obligers/

# GitHub-Pages-shaped URLs. On github.io this site lives under /star-rangers/,
# so links copied from there (or old bookmarks) carry the prefix; the cPanel
# domains serve the same pages at the root, so nothing legitimate ever lives
# under /star-rangers/ here and the whole namespace can be forwarded wholesale.
RedirectMatch 301 ^/star-rangers/(.*)$ /$1
RedirectMatch 301 ^/star-rangers$ /

# Custom 404. Without this, a dead address surfaces Apache's default error -
# and, because cPanel's stock config points ErrorDocument at a file this site
# never shipped, a second "404 while handling the 404" note under it. The page
# is built by src/404.md at the site root on every target; GitHub Pages picks
# the same file up by convention.
ErrorDocument 404 /404.html

# Legacy WordPress permalinks: 410 Gone, not a soft 200.
#
# sciencefiction.site ran WordPress under a previous occupant, and Google still
# holds that site's URLs. A static server ignores query strings, so every stale
# permalink - /?p=417, /?cat=3, /?m=202001 - resolves 200 and serves the
# homepage. To a crawler those URLs still work and now show unrelated content,
# which is a soft-404 pattern that keeps a dead site alive in the index long
# after its files are gone. It is the likeliest reason Google still classifies
# this domain as the WordPress site it used to be.
#
# 410 rather than 404 is the point. 404 means "not found, maybe later" and gets
# retried for months; 410 means "permanently gone" and is dropped far faster.
#
# Scoped to `^$` - the site root only - and to numeric values, so it can match
# nothing this site serves. Every real URL here is a path (/lore/..., /seasons/
# ...), and no page takes any of these parameters. Pagefind's search UI is not
# affected: it is client-side and does not use these names.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|m|author)=[0-9]+
  RewriteRule ^$ - [G,L]
</IfModule>

# Prevent content-type sniffing
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-XSS-Protection "0"

  # Conservative CSP for static site with same-origin assets.
  # 'wasm-unsafe-eval' is required by the search box: Pagefind compiles a
  # WebAssembly module client-side at init(), and Chromium-family browsers
  # gate WASM compilation on script-src - without this token the import
  # fails and search silently returns nothing (search.js swallows the error).
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'wasm-unsafe-eval' https:; font-src 'self' data: https:; connect-src 'self' https:; frame-src https://giscus.app; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Block access to hidden files except .well-known
<FilesMatch "^\.(?!well-known/)">
  Require all denied
</FilesMatch>

# Ensure security.txt serves as plain text
<Files "security.txt">
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
  </IfModule>
</Files>
