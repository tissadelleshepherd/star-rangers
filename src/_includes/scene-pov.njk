---
layout: base.njk
comments: true
commentsCategory: episodes
---
{#- A hidden POV page (see the `item.included` branch below) must drop out of
    the Pagefind index entirely: the header above that branch renders the POV
    character's name and the chapter's in-universe timestamp/location, which
    would otherwise be searchable on builds that exclude the chapter. Same
    blind spot as `robots` in src/scene-pov.njk - these pages never get the
    excluded.njk layout swap, so .eleventy.js's overrides can't cover them. -#}
<article class="chapter scene-pov" data-chapter-id="{{ item.chapterId }}" data-scene="{{ item.sceneNumber }}" data-pov="{{ item.character.id }}"{% if not item.included %} data-pagefind-ignore{% endif %}>
  <header class="chapter-header">
    <nav class="chapter-breadcrumb" aria-label="Chapter location" data-pagefind-ignore>
      <ol class="breadcrumb" role="list">
        <li><a href="/star-rangers/seasons/">Seasons</a></li>
        <li><a href="/star-rangers/seasons/s{{ item.season }}/">{{ item.season | int | seasonLabel }}</a></li>
        <li><a href="/star-rangers/seasons/s{{ item.season }}/e{{ item.episode }}/">Episode {{ item.episode | int }}</a></li>
        <li><a href="/star-rangers{{ item.chapterUrl }}">{{ item.chapterTitle }}</a></li>
        <li aria-current="page">Scene {{ item.sceneNumber }} — {{ item.character.label }}</li>
      </ol>
    </nav>

    <div class="chapter-meta">
      <span class="chapter-label">Scene {{ item.sceneNumber }}</span>
    </div>

    <div class="scene-pov-heading">
      {% if item.character.image %}
      <a class="scene-pov-heading__portrait-link" href="/star-rangers{{ item.character.url }}">
        <img class="scene-pov-heading__portrait" src="/star-rangers/images/characters/{{ item.character.image }}" alt="{{ item.character.imageAlt | default('Portrait of ' + item.character.label) }}" width="72" height="72" loading="lazy" />
      </a>
      {% endif %}
      <h1 class="chapter-title">{{ item.character.label }}</h1>
    </div>

    <dl class="chapter-details">
      {% if item.timestamp %}
      <div class="chapter-detail">
        <dt>Time</dt>
        <dd>{{ item.timestamp }}</dd>
      </div>
      {% endif %}
      {% if item.location %}
      <div class="chapter-detail">
        <dt>Location</dt>
        <dd>{{ item.location }}</dd>
      </div>
      {% endif %}
    </dl>

    {% if item.image %}
    <img class="entry-image" src="/star-rangers/images/scenes/{{ item.image }}" alt="{{ item.imageAlt }}" />
    {% endif %}
  </header>

  {% if item.sceneCharacters.length > 1 %}
  <nav class="scene-pov-switch" aria-label="Other POVs of this scene" data-pagefind-ignore>
    <p class="scene-pov-switch__label">Also in this scene:</p>
    <ul class="scene-pov-switch__list" role="list">
      {% for character in item.sceneCharacters %}
      {% if character.id != item.character.id %}
      <li>
        <a class="scene-pov-switch__link" href="/star-rangers/seasons/s{{ item.season }}/e{{ item.episode }}/{{ item.chapterId }}/scene-{{ item.sceneNumber }}/{{ character.id }}/">
          {%- if character.image -%}
          <img class="scene-pov-switch__portrait" src="/star-rangers/images/characters/{{ character.image }}" alt="" width="32" height="32" loading="lazy" />
          {%- endif -%}
          {{ character.label }}</a>
      </li>
      {% endif %}
      {% endfor %}
    </ul>
  </nav>
  {% endif %}

  <div class="chapter-body">
    {% if item.included %}
    {{ item.html | safe }}
    {% else %}
    {% if edition.excludedNotice %}
    <p class="page-intro">{{ edition.excludedNotice.intro }}</p>
    <p><a href="/star-rangers/start/">← {{ edition.excludedNotice.back }}</a></p>
    {% else %}
    <p class="page-intro">Not included in this edition.</p>
    {% endif %}
    {% endif %}
  </div>

  <nav class="chapter-pagination" aria-label="Chapter navigation" data-pagefind-ignore>
    <a class="chapter-pagination__prev" href="/star-rangers{{ item.chapterUrl }}">
      ← {{ item.chapterTitle }} (all POVs)
    </a>
  </nav>
</article>
