---
layout: base.njk
comments: true
commentsCategory: lore
---
<article class="glossary-entry" id="{{ id | default(title | lower | replace(' ', '-')) }}">
  <header class="glossary-entry__header">
    <nav class="glossary-breadcrumb" aria-label="Glossary location" data-pagefind-ignore>
      <ol class="breadcrumb" role="list">
        <li><a href="/star-rangers/glossary/">Glossary</a></li>
        <li aria-current="page">{{ title }}</li>
      </ol>
    </nav>
    <h1 class="glossary-entry__term">{{ title }}</h1>
    {% if irish %}
    {#- "Union Irish" is the Celtic Union's 29th-century Gaelic, an in-story language
        (Dermot, 2026-09-24 and 2026-10-05); the label links the canonical guide's
        definition so a reader who knows Irish is not told this is theirs. -#}
    <p class="glossary-entry__irish">In <a class="glossary-entry__irish-label" href="/star-rangers/lore/glossary/canonical-glossary-and-migration-guide/#union-irish" title="The Celtic Union's 29th-century Gaelic, an in-story language">Union Irish</a>: <span lang="ga">{{ irish }}</span>{% if irish_gloss %} <span class="glossary-entry__irish-gloss">— {{ irish_gloss }}</span>{% endif %}</p>
    {% endif %}
    {% if category %}
    <p class="glossary-entry__category">
      <span class="character-badge">{{ category }}</span>
    </p>
    {% endif %}
    {% if image %}
    <img class="entry-image" src="/star-rangers/images/glossary/{{ image }}" alt="{{ image_alt | default(title) }}" />
    {% endif %}
  </header>

  {% if plain %}
  <aside class="plain-summary">
    <h2 class="plain-summary__heading">In short</h2>
    <p class="plain-summary__text">{{ plain }}</p>
  </aside>
  {% endif %}

  <div class="glossary-entry__body">
    {{ content | safe }}
  </div>

  {# Only the related terms whose pages THIS build carries: on a narrowed
     edition an excluded page's term drops out rather than linking to the
     glossary index, and the aside goes with it when none are left. #}
  {% set relatedHere = related | resolvedRelatedTerms(collections.glossary, collections.lore) %}
  {% if relatedHere and relatedHere.length %}
  <aside class="glossary-related">
    <h2 class="glossary-related__heading">Related Terms</h2>
    <ul class="glossary-related__list" role="list">
      {% for item in relatedHere %}
      <li><a href="{{ item.url }}">{{ item.term }}</a></li>
      {% endfor %}
    </ul>
  </aside>
  {% endif %}

  <footer class="glossary-entry__footer" data-pagefind-ignore>
    <a href="/star-rangers/glossary/">← Back to Glossary</a>
  </footer>
</article>
